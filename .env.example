# Infura Project ID for Ethereum connection
INFURA_PROJECT_ID=your_infura_project_id_here

# Private key of the wallet that will dispense USDC (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# USDC contract address for your testnet (Sepolia, Goerli, etc.)
# This should be the testnet USDC contract address that matches your network
USDC_CONTRACT_ADDRESS=your_testnet_usdc_contract_address_here

# Etherscan API key for contract verification
# Get your API key from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here
